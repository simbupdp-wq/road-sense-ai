# Leave blank to use Vite's same-origin /api proxy.
VITE_API_BASE_URL=
VITE_DEV_PROXY_TARGET=http://127.0.0.1:8001

# Fill these only after the API teammate confirms the POST /api/analyze
# multipart field names. The frontend intentionally sends no upload if blank.
VITE_ANALYZE_VIDEO_FIELD=
VITE_ANALYZE_CAMERA_ID_FIELD=

# Set to the confirmed dotted response path for the annotated-video URL,
# for example a path documented by the API teammate. No default is assumed.
VITE_ANNOTATED_VIDEO_URL_PATH=
